<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:oms.order" targetNamespace="urn:oms.order" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:annotation>
		<xs:documentation> Version schema 5.90</xs:documentation>
	</xs:annotation>
	<xs:element name="order">
		<xs:annotation>
			<xs:documentation>Заказ кодов маркировки</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:element name="lp" type="OrderLpType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Предметы одежды, белье постельное, столовое, туалетное и кухонное»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="shoes" type="OrderShoesType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Обувные товары»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="electronics" type="OrderElectronicsType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Фотокамеры (кроме кинокамер), фотовспышки и лампы-вспышки»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="tires" type="OrderTiresType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Шины и покрышки пневматические резиновые новые»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="perfumery" type="OrderPerfumeryType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Духи и туалетная вода»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="bicycle" type="OrderBicycleType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Велосипеды и велосипедные рамы»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="wheelchairs" type="OrderWheelchairsType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Медицинские изделия»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="milk" type="OrderMilkType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Молочные продукты»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="tobacco" type="OrderTobaccoType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Табачная продукция»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="pharma" type="OrderPharmaType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Лекарственные препараты для медицинского применения»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="otp" type="OrderOtpType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Альтернативная табачная продукция»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="water" type="OrderWaterType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Питьевая вода»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="beer" type="OrderBeerType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Пиво, напитки, изготавливаемые на основе пива и слабоалкогольные напитки»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ncp" type="OrderNcpType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Никотиносодержащая продукция»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="bio" type="OrderBioType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Специализированная пищевая продукция и БАД к пище»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="antiseptic" type="OrderAntisepticType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Антисептики и дезинфицирующие средства»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="petfood" type="OrderPetfoodType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Корма для животных»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="seafood" type="OrderSeafoodType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Морепродукты»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="nabeer" type="OrderNabeerType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Безалкогольное пиво»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="softdrinks" type="OrderSoftdrinksType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Соковая продукция и безалкогольные напитки»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="toys" type="OrderToysType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Игры и игрушки для детей»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="titan" type="OrderTitanType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Титановая металлопродукция»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="radio" type="OrderRadioType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Радиоэлектронная продукцияя»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="vegetableoil" type="OrderVegetableoilType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Растительные масла»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="chemistry" type="OrderChemistryType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Косметика, бытовая химия и товары личной гигиены»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="opticfiber" type="OrderOpticfiberType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Оптоволокно и оптоволоконная продукция»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="conserve" type="OrderConserveType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Консервированная продукция»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="vetpharma" type="OrderVetpharmaType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Ветеринарные препараты»</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="grocery" type="OrderGroceryType">
					<xs:annotation>
						<xs:documentation>Категория товарной группы «Бакалейная продукция»</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<!-- simpleType -->
	<xs:simpleType name="serialNumberType">
		<xs:annotation>
			<xs:documentation>Способ формирования серийного номера. Самостоятельно - SELF_MADE, 	Оператором - OPERATOR </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SELF_MADE"/>
			<xs:enumeration value="OPERATOR"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="releaseMethodType">
		<xs:annotation>
			<xs:documentation>Способ выпуска товаров в оборот.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PRODUCTION"/>
			<xs:enumeration value="IMPORT"/>
			<xs:enumeration value="REMAINS"/>
			<xs:enumeration value="CROSSBORDER"/>
			<xs:enumeration value="REMARK"/>
			<xs:enumeration value="COMMISSION"/>
			<xs:enumeration value="REAPPLY"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="createMethodType">
		<xs:annotation>
			<xs:documentation>Способ изготовления.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="SELF_MADE"/>
			<xs:enumeration value="CEM"/>
			<xs:enumeration value="CM"/>
			<xs:enumeration value="CL"/>
			<xs:enumeration value="CA"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="productGroupType">
		<xs:annotation>
			<xs:documentation/>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="lp"/>
			<xs:enumeration value="shoes"/>
			<xs:enumeration value="tobacco"/>
			<xs:enumeration value="perfumery"/>
			<xs:enumeration value="tires"/>
			<xs:enumeration value="electronics"/>
			<xs:enumeration value="pharma"/>
			<xs:enumeration value="milk"/>
			<xs:enumeration value="bicycle"/>
			<xs:enumeration value="wheelchairs"/>
			<xs:enumeration value="otp"/>
			<xs:enumeration value="water"/>
			<xs:enumeration value="beer"/>
			<xs:enumeration value="ncp"/>
			<xs:enumeration value="bio"/>
			<xs:enumeration value="antiseptic"/>
			<xs:enumeration value="petfood"/>
			<xs:enumeration value="seafood"/>
			<xs:enumeration value="nabeer"/>
			<xs:enumeration value="softdrinks"/>
			<xs:enumeration value="toys"/>
			<xs:enumeration value="titan"/>
			<xs:enumeration value="radio"/>
			<xs:enumeration value="vegetableoil"/>
			<xs:enumeration value="chemistry"/>
			<xs:enumeration value="opticfiber"/>
			<xs:enumeration value="conserve"/>
			<xs:enumeration value="vetpharma"/>
			<xs:enumeration value="grocery"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="cisType">
		<xs:annotation>
			<xs:documentation/>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UNIT"/>
			<xs:enumeration value="BUNDLE"/>
			<xs:enumeration value="SET"/>
			<xs:enumeration value="GROUP"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- OrderProducts -->
	<xs:complexType name="OrderProduct">
		<xs:sequence>
			<xs:element name="gtin">
				<xs:annotation>
					<xs:documentation>Код товара (GTIN)</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:length value="14"/>
						<xs:pattern value="[0-9]{14}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="quantity">
				<xs:annotation>
					<xs:documentation>Количество кодов маркировки</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:positiveInteger">
						<xs:minInclusive value="1"/>
						<xs:maxInclusive value="150000"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="serialNumberType">
				<xs:annotation>
					<xs:documentation>Способ генерации серийных номеров.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:annotation>
						<xs:documentation>Способ формирования серийного номера. Самостоятельно - SELF_MADE, 	Оператором - OPERATOR </xs:documentation>
					</xs:annotation>
					<xs:restriction base="xs:string">
						<xs:enumeration value="SELF_MADE"/>
						<xs:enumeration value="OPERATOR"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="serialNumbers" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Массив серийных номеров. Это поле указывается в случае, если значение «serialNumberType = SELF_MADE» </xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence maxOccurs="150000">
						<xs:element name="serialNumber" type="xs:string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OrderProductLp">
		<xs:complexContent>
			<xs:extension base="OrderProduct">
				<xs:sequence>
					<xs:element name="cisType">
						<xs:annotation>
							<xs:documentation>Тип КМ</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="cisType">
								<xs:enumeration value="UNIT"/>
								<xs:enumeration value="BUNDLE"/>
								<xs:enumeration value="SET"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
					<xs:element name="templateId">
						<xs:annotation>
							<xs:documentation>Идентификатор шаблона КМ</xs:documentation>
						</xs:annotation>
						<xs:simpleType>
							<xs:restriction base="xs:positiveInteger">
								<xs:enumeration value="10"/>
								<xs:enumeration value="35"/>
							</xs:restriction>
						</xs:simpleType>
					</xs:element>
					<xs:element name="producer" type="xs:string" minOccurs="0">
						<xs:annotation>
							<xs:documentation>ИНН владельца карточки товара</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
