# Скопируйте в .env и заполните. Файл .env никому не показывайте и не выкладывайте в git.

# --- Адрес сайта: ваш домен (HTTPS включится сам). Домен должен указывать на IP этой машины.
SITE_ADDRESS=sklad.example.ru
# Только для проверки без домена: SITE_ADDRESS=:80 и COOKIE_SECURE=false (пароли пойдут без шифрования!)

# --- Случайная строка от 32 символов: openssl rand -hex 32
SESSION_SECRET=

# --- База данных: та же, что у приложения (Яндекс Managed PostgreSQL)
# Хост - основной (rw): c-<id кластера>.rw.mdb.yandexcloud.net, порт 6432
DB_HOST=c-xxxxxxxxxxxxxxxxxxxx.rw.mdb.yandexcloud.net
DB_PORT=6432
DB_NAME=
DB_USER=web_user
DB_PASSWORD=

# Шифрование: require - как в приложении; verify - ещё и проверка сертификата (рекомендуется,
# нужен файл certs/root.crt, см. README)
DB_SSL=verify
DB_SSL_CA=/certs/root.crt

# Сколько часов действует вход без активности (по умолчанию 12)
# SESSION_HOURS=12
# Часовой пояс для дат на страницах (по умолчанию Europe/Moscow)
# DISPLAY_TZ=Europe/Moscow
